PORT=8000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Cookies: "lax" (default) when frontend + API share a site; "none" if they are
# on different sites (forces Secure). COOKIE_SECURE=false only for plain-HTTP
# non-localhost testing.
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false

# Set when running behind a reverse proxy so rate limits use the real client IP
# TRUST_PROXY=1

# Required for login / refresh — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# Links in emails point at the frontend pages
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:5173/verify-email
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

# Required for register / forgot-password / resend verification (https://mailtrap.io)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
MAIL_FROM=Project Camp <no-reply@projectcamp.dev>

# Demo escape hatch: "true" marks new accounts verified on creation and sends no
# verification email, so the app works without an email provider. Anyone can then
# register with an address they don't own — leave it off for anything real.
# AUTO_VERIFY_EMAIL=true
