# Base URL used by axios. In dev, "/api/v1" goes through the Vite proxy.
# In production, set the full backend URL, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Backend origin the Vite dev server proxies "/api" requests to
VITE_BACKEND_URL=http://localhost:3000

# Optional: prefill the sign-in form with a shared demo account (public)
# VITE_DEMO_EMAIL=johndoe@test.com
# VITE_DEMO_PASSWORD=John1234
